rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }
    function hasRole(roles) {
      return request.auth != null && exists(roleDoc()) && get(roleDoc()).data.role in roles;
    }
    // The site a staff member works at (the owner sees every site).
    function userSite() {
      return get(roleDoc()).data.get('site', 'forum');
    }

    match /roles/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || hasRole(['owner']);
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'pending'
                    && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'createdAt']);
      allow update: if hasRole(['owner'])
                    && request.resource.data.role in ['pending', 'attendant', 'security', 'none']
                    && resource.data.role != 'owner'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'site', 'changedAt']);
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function changed() { return d().diff(o()).affectedKeys(); }
      function locked() {
        return d().plateKey == o().plateKey && d().consent == o().consent
            && d().bookedAt == o().bookedAt && d().phone == o().phone;
      }
      function step(from, to) { return o().status == from && d().status == to; }
      function goodRating() {
        return d().rating is int && d().rating >= 1 && d().rating <= 5
            && (!('ratingComment' in d()) || (d().ratingComment is string && d().ratingComment.size() <= 300));
      }
      function goodBooking() {
        return d().status == 'booked' && d().consent == true
            && d().plateKey is string && d().plateKey.size() >= 6 && d().plateKey.size() <= 12
            && d().bay is string && d().bay.size() <= 40
            && d().phone is string && d().phone.size() <= 20
            && d().get('site', 'forum') is string && d().get('site', 'forum').size() <= 40
            && d().get('backBy', '') is string && d().get('backBy', '').size() <= 40;
      }
      function goodIssue() {
        return d().issue.keys().hasOnly(['status', 'type', 'text', 'at']) && d().issue.status == 'open'
            && d().issue.text is string && d().issue.text.size() <= 500 && d().issue.type is string && d().issue.type.size() <= 60;
      }
      function staffHere() {
        return hasRole(['owner']) || (hasRole(['attendant']) && o().get('site', 'forum') == userSite());
      }
      // Once a car is verified, only the attendant on the job can move it on (or someone who takes it over).
      function mine() {
        return o().status == 'booked' || o().get('attendantUid', '') == '' || o().attendantUid == request.auth.uid;
      }

      // Reading one ticket by its private id is open; listing is staff only, and only for their own site.
      allow get: if true;
      allow list: if hasRole(['owner'])
                  || (hasRole(['attendant', 'security']) && resource.data.site == userSite());

      allow create: if
          // Customer books from the QR code.
          (goodBooking() && d().keys().hasOnly(['code', 'plate', 'plateKey', 'bay', 'phone', 'service', 'site', 'zone', 'day', 'status', 'consent', 'bookedAt', 'alerts', 'backBy', 'estReadyAt']))
          ||
          // Attendant books a walk-up customer at their own site.
          (goodBooking() && hasRole(['attendant', 'owner']) && d().walkUp == true && d().createdBy == request.auth.uid
            && (hasRole(['owner']) || d().site == userSite())
            && d().keys().hasOnly(['code', 'plate', 'plateKey', 'bay', 'phone', 'service', 'site', 'zone', 'day', 'status', 'consent', 'bookedAt', 'alerts', 'walkUp', 'createdBy', 'backBy']))
          ||
          (hasRole(['owner']) && d().example == true);

      allow update: if
          (step('booked', 'cancelled') && changed().hasOnly(['status', 'cancelledAt', 'alerts']))
          ||
          (step('ready', 'closed') && changed().hasOnly(['status', 'paidAt', 'paidVia', 'alerts']))
          ||
          (o().status == 'closed' && d().status == 'closed' && !('rating' in o())
            && changed().hasOnly(['rating', 'ratingComment', 'ratedAt']) && goodRating())
          ||
          // Customer reports a problem on a finished wash (once).
          (o().status == 'closed' && d().status == 'closed' && !('issue' in o())
            && changed().hasOnly(['issue', 'alerts']) && goodIssue())
          ||
          // Owner resolves a complaint.
          (hasRole(['owner']) && ('issue' in o()) && changed().hasOnly(['issue', 'alerts']))
          ||
          (staffHere() && locked() && o().status in ['verified', 'washing', 'ready']
            && d().status == o().status && d().attendantUid == request.auth.uid
            && changed().hasOnly(['attendant', 'attendantUid', 'alerts']))
          ||
          (staffHere() && locked() && mine() && (
               step('booked', 'verified')
            || (step('verified', 'washing') && 'before' in d().photos && d().damage is map)
            || (step('washing', 'ready') && 'after' in d().photos)
            || step('ready', 'closed')
            || ((step('booked', 'noshow') || step('verified', 'noshow')) && d().noshowReason is string && d().noshowReason.size() <= 100)
            || (d().status == o().status && changed().hasOnly(['photos', 'damage', 'checklist']))
          ));

      allow delete: if hasRole(['owner']);
    }

    match /ticketPhotos/{ticketId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if hasRole(['attendant', 'owner'])
                    && request.resource.data.keys().hasOnly(['before', 'after', 'damage'])
                    && get(/databases/$(database)/documents/tickets/$(ticketId)).data.get('attendantUid', '') in ['', request.auth.uid];
      allow delete: if hasRole(['owner']);
    }

    // Queue figures and the live board for each site. Anyone can read one site's document;
    // staff phones write it. It holds counts and masked plates only.
    match /public/{siteId} {
      allow get: if true;
      allow list: if false;
      allow write: if (hasRole(['owner']) || (hasRole(['attendant', 'security']) && userSite() == siteId))
                    && request.resource.data.keys().hasOnly(['ahead', 'avgMin', 'workers', 'jobs', 'today', 'updatedAt'])
                    && request.resource.data.jobs is list && request.resource.data.jobs.size() <= 40;
    }

    // Attendant shifts: one document per person per day, id "<uid>_<YYYY-MM-DD>".
    match /shifts/{shiftId} {
      allow read: if hasRole(['owner']) || (request.auth != null && shiftId.matches(request.auth.uid + '_.*'));
      allow create, update: if hasRole(['attendant', 'owner'])
                    && request.resource.data.uid == request.auth.uid
                    && shiftId == request.auth.uid + '_' + request.resource.data.day
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'site', 'day', 'sessions'])
                    && request.resource.data.sessions is list && request.resource.data.sessions.size() <= 20;
      allow delete: if hasRole(['owner']);
    }
  }
}
