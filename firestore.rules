rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }
    function hasRole(roles) {
      return request.auth != null && exists(roleDoc()) && get(roleDoc()).data.role in roles;
    }

    match /roles/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || hasRole(['owner']);
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.role == 'pending'
                    && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'createdAt']);
      allow update: if hasRole(['owner'])
                    && request.resource.data.role in ['pending', 'attendant', 'security', 'none']
                    && resource.data.role != 'owner';
      allow delete: if false;
    }

    match /tickets/{ticketId} {
      function d() { return request.resource.data; }
      function o() { return resource.data; }
      function changed() { return d().diff(o()).affectedKeys(); }
      function locked() {
        return d().plateKey == o().plateKey && d().consent == o().consent
            && d().bookedAt == o().bookedAt && d().phone == o().phone;
      }
      function step(from, to) { return o().status == from && d().status == to; }
      function goodRating() {
        return d().rating is int && d().rating >= 1 && d().rating <= 5
            && (!('ratingComment' in d()) || (d().ratingComment is string && d().ratingComment.size() <= 300));
      }

      allow get: if true;
      allow list: if hasRole(['attendant', 'security', 'owner']);

      allow create: if (
            d().status == 'booked' && d().consent == true
            && d().plateKey is string && d().plateKey.size() >= 6 && d().plateKey.size() <= 12
            && d().bay is string && d().bay.size() <= 40
            && d().phone is string && d().phone.size() <= 20
            && d().keys().hasOnly(['code', 'plate', 'plateKey', 'bay', 'phone', 'service', 'status', 'consent', 'bookedAt', 'alerts'])
          ) || (hasRole(['owner']) && d().example == true);

      allow update: if
          // Customer cancels before work starts.
          (step('booked', 'cancelled') && changed().hasOnly(['status', 'cancelledAt', 'alerts']))
          ||
          // Customer pays for a ready car (demo payment).
          (step('ready', 'closed') && changed().hasOnly(['status', 'paidAt', 'paidVia', 'alerts']))
          ||
          // Customer rates a finished wash, once.
          (o().status == 'closed' && d().status == 'closed' && !('rating' in o())
            && changed().hasOnly(['rating', 'ratingComment', 'ratedAt']) && goodRating())
          ||
          // Staff move the job forward one step at a time.
          (hasRole(['attendant', 'owner']) && locked() && (
               step('booked', 'verified')
            || (step('verified', 'washing') && 'before' in d().photos && d().damage is map)
            || (step('washing', 'ready') && 'after' in d().photos)
            || step('ready', 'closed')
            || (d().status == o().status && changed().hasOnly(['photos', 'damage']))
          ));

      allow delete: if hasRole(['owner']);
    }

    // Photos are kept apart from tickets so ticket lists stay small.
    match /ticketPhotos/{ticketId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if hasRole(['attendant', 'owner'])
                    && request.resource.data.keys().hasOnly(['before', 'after', 'damage']);
      allow delete: if hasRole(['owner']);
    }
  }
}
